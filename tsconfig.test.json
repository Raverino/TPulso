{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.test.ts",
    "worker",
    "shared",
    "src/lib",
    "scripts",
    "fixtures/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
